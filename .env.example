POSTGRES_USER=boncosaurus
POSTGRES_PASSWORD=boncosaurus
POSTGRES_DB=boncosaurus
POSTGRES_PORT=5434
BACKEND_PORT=3000
FRONTEND_PORT=5173
# Untuk dev lokal (di luar docker); di docker di-override ke host "db"
DATABASE_URL=postgres://boncosaurus:boncosaurus@localhost:5434/boncosaurus

# Auth: wajib, minimal 32 karakter. Buat dengan: openssl rand -base64 48
JWT_SECRET=
# Origin frontend untuk CORS (cookie refresh token memakai credentials)
FRONTEND_ORIGIN=http://localhost:5173
# Set true kalau diakses lewat HTTPS (default true saat NODE_ENV=production)
COOKIE_SECURE=
# Zona waktu server frontend; menentukan batas bulan di dashboard
TZ=Asia/Jakarta
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000

# Asisten AI: kunci enkripsi API key provider (32 byte base64). Buat dengan: openssl rand -base64 32
# Kosongkan untuk menonaktifkan fitur AI. Jangan diganti setelah dipakai, API key tersimpan tidak bisa dibaca lagi.
AI_SECRET_KEY=

# First-run self-host: dibuat otomatis saat database masih kosong.
# Kalau ADMIN_EMAIL kosong, bootstrap dilewati. ADMIN_PASSWORD wajib (min 8 karakter)
# bila ADMIN_EMAIL diisi; juga dipakai untuk mengisi password admin lama yang belum punya.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
WORKSPACE_NAME=Keuangan Saya
BASE_CURRENCY=IDR
