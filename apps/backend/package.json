{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts",
    "db:studio": "bun --env-file=../../.env run drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/google": "^4.0.95",
    "@ai-sdk/openai": "^4.0.93",
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@elysiajs/cors": "^1.4.2",
    "ai": "^7.0.140",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "jose": "^6.2.12",
    "papaparse": "^5.7.0",
    "read-excel-file": "^9.3.12",
    "unpdf": "^1.8.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/papaparse": "^5.5.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
